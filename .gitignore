# Godot 4 caches imported assets and editor state here. It is regenerated
# automatically when the project is opened, so it should never be committed.
.godot/

# Exported game builds (APK, IPA, web, desktop binaries).
build/
export/
*.apk
*.aab
*.ipa

# Godot-generated "user" mono / C# artifacts (not used here, but common).
.mono/
data_*/
mono_crash.*.json

# OS junk
.DS_Store
Thumbs.db
